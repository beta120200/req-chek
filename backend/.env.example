PORT=3000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated for several)
FRONTEND_URL=http://localhost:5173

# SUPABASE
SUPABASE_URL=your_supabase_url_here
# Secret / service_role key: server only, never expose it to the frontend
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Publishable / anon key: used for sign-up, sign-in and token refresh
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
